{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Personality",
  "type": "object",
  "required": ["id", "name", "description", "values", "speech_style"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "values": {
      "type": "object",
      "required": ["risk_taking", "honesty", "aggression"],
      "additionalProperties": false,
      "properties": {
        "risk_taking": {"type": "integer", "minimum": 0, "maximum": 100},
        "honesty": {"type": "integer", "minimum": 0, "maximum": 100},
        "aggression": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "speech_style": {"type": "string", "minLength": 1}
  }
}
