{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Werewolf role",
  "type": "object",
  "required": ["id", "name", "team", "unique", "weight", "night_order", "hooks", "description"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "team": {"enum": ["village", "wolves", "solo"]},
    "unique": {"type": "boolean"},
    "weight": {"type": "integer"},
    "night_order": {"type": ["integer", "null"], "minimum": 1},
    "first_night_only": {"type": "boolean"},
    "hooks": {"type": "object", "additionalProperties": {"type": "string"}},
    "description": {"type": "string", "minLength": 1}
  }
}
