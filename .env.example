# Copy to .env and fill in. .env is gitignored; never commit real values.

# OpenRouter API key for `arena run --models` outside Compose. Leave empty to
# play with random bots and the mock LLM only (no cost). Spending is capped in
# config/models.yaml. Load this file with `uv run --env-file .env ...`.
OPENROUTER_API_KEY=

# Real models in the Compose stack (docker-compose.models.yml, docs/COSTS.md):
# a file outside the repository that holds only the key, and the spend ledger
# database as the arena container reaches it.
OPENROUTER_API_KEY_PATH=
LEDGER_DATABASE_URL=

# Password of the local Postgres container (the port is bound to 127.0.0.1).
# Set it before the first start; changing it later needs `docker compose down -v`.
POSTGRES_PASSWORD=change-me
