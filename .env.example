# Copy to .env and fill in. .env is gitignored; never commit real values.

# OpenRouter API key for matches with real models. Leave empty to play with
# random bots and the mock LLM only (no cost). Spending is capped in
# config/models.yaml. Outside Compose, load this file with
# `uv run --env-file .env ...`.
OPENROUTER_API_KEY=

# Password of the local Postgres container (the port is bound to 127.0.0.1).
# Set it before the first start; changing it later needs `docker compose down -v`.
POSTGRES_PASSWORD=change-me
